<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/library_bg">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tool_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/library_bg"
        app:title="Library"
        android:layout_marginTop="16dp"
        android:paddingTop="8dp"
        style="@style/ToolbarTitleStyle"
        app:titleTextColor="@color/library_primary"
        app:menu="@menu/tool_bar"
        app:popupTheme="@color/library_secondary"
        app:titleTextAppearance="@style/ToolbarTitleStyle"
        app:elevation="4dp"/>


    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemTextColor="@color/library_primary"
        app:itemIconTint="@color/library_primary"
        app:labelVisibilityMode="labeled"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="false"
        app:menu="@menu/bottom_navigation" />

</LinearLayout>