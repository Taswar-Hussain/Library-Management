<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AboutUs">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="About Library"
        android:elevation="4dp"
        android:id="@+id/aboutToolbar"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:navigationIconTint="@color/library_primary"
        app:titleTextAppearance="@style/ToolbarTitleStyle"
        app:titleTextColor="@color/library_primary"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/aboutimg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/gemini_svg"
        android:layout_margin="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aboutToolbar" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Library App"
        android:textColor="@color/library_text"
        android:textSize="24dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/aboutimg"
        tools:layout_editor_absoluteX="32dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:padding="4dp"
        android:text="Version 1.0.0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <TextView
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:text="Welcome to Library! Your digital companion to\ndiscover, organize, and save your favorite reads on\nthe go. This app is designed to bring you closer to\nyour passion for books, providing a seamless\nbrowsing and offline saving experience with\ncustom theme preferences."
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="16dp"
        android:textAlignment="center"
        android:gravity="center"
        android:textColor="@color/library_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <!-- rate us card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/about_us_cards"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/desc"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imgCardIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="11dp"
                android:src="@drawable/ic_star"
                app:tint="?attr/colorOnSurface" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rate Us"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCardSubTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.7"
                    android:text="support our development."
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Share with firends -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardActtion_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/about_us_cards"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardAction"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imgCardIcon1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="11dp"
                android:src="@drawable/ic_share"
                app:tint="?attr/colorOnSurface" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCardTitleshare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Share with Friends"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCardSubTitleshare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.7"
                    android:text="recommemd this library to others."
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- official repo -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardActtion_repo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/about_us_cards"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardActtion_share"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imgCardIcon2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="11dp"
                android:src="@drawable/ic_git"
                app:tint="?attr/colorOnSurface" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCardTitle_git"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Official Repository"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCardSubTitle_git"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.7"
                    android:text="view source code."
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
<!--Feed Back  -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardActtion_feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/about_us_cards"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardActtion_repo"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imgCardIcon3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="11dp"
                android:src="@drawable/ic_email"
                app:tint="?attr/colorOnSurface" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCardTitle_feed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Feedback &amp; Support"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCardSubTitle_feed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.7"
                    android:text="email developer."
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txt23"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:alpha="0.8"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Developed by Taswar Hussain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardActtion_feedback" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:alpha="0.8"
        android:gravity="center"
        android:text="© 2026 Library management"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt23"/>


</androidx.constraintlayout.widget.ConstraintLayout>